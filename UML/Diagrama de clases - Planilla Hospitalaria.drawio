Space=wrap;html=1;fillColor=#fffbd0;strokeColor=#b3a100;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="348" width="330" height="42" as="geometry"/></mxCell><mxCell id="c95" value="DIP / ISP: SistemaPlanilla depende de las&lt;br&gt;abstracciones Almacen*; main le inyecta los&lt;br&gt;Archivo*. Una interfaz pequeña por cada archivo." style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#fffbd0;strokeColor=#b3a100;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1620" y="211" width="300" height="57" as="geometry"/></mxCell><mxCell id="c96" value="Composición: Departamento crea sus Puesto en&lt;br&gt;agregarPuesto() y los destruye en ~Departamento().&lt;br&gt;Cada lista es dueña de sus nodos y de sus datos:&lt;br&gt;su destructor hace delete de los dos." style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#fffbd0;strokeColor=#b3a100;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1880" y="1528" width="300" height="72" as="geometry"/></mxCell><mxCell id="c97" value="Agregación: ComprobantePago solo guarda la&lt;br&gt;dirección de su Empleado y su Departamento;&lt;br&gt;no los crea ni los destruye." style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#fffbd0;strokeColor=#b3a100;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1880" y="1638" width="300" height="57" as="geometry"/></mxCell><mxCell id="c98" value="Leyenda de flechas" style="text;html=1;fontStyle=1;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry x="1086" y="1991" width="220" height="24" as="geometry"/></mxCell><mxCell id="c99" style="endArrow=block;endFill=0;endSize=16;html=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1086" y="2031" as="sourcePoint"/><mxPoint x="1176" y="2031" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c100" value="Herencia (es un)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1191" y="2021" width="300" height="20" as="geometry"/></mxCell><mxCell id="c101" style="startArrow=diamondThin;startFill=1;startSize=20;endArrow=none;html=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1086" y="2061" as="sourcePoint"/><mxPoint x="1176" y="2061" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c102" value="Composición (rombo negro en el todo)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1191" y="2051" width="300" height="20" as="geometry"/></mxCell><mxCell id="c103" style="startArrow=diamondThin;startFill=0;startSize=20;endArrow=none;html=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1086" y="2091" as="sourcePoint"/><mxPoint x="1176" y="2091" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c104" value="Agregación (rombo blanco en el todo)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1191" y="2081" width="300" height="20" as="geometry"/></mxCell><mxCell id="c105" style="endArrow=open;endFill=0;endSize=11;html=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1086" y="2121" as="sourcePoint"/><mxPoint x="1176" y="2121" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c106" value="Asociación (usa / conoce a)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1191" y="2111" width="300" height="20" as="geometry"/></mxCell><mxCell id="c107" style="endArrow=open;endFill=0;endSize=11;dashed=1;html=1;rounded=0;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1086" y="2151" as="sourcePoint"/><mxPoint x="1176" y="2151" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c108" value="Dependencia (crea o usa por un rato)" style="t